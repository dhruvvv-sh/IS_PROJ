# CipherChat Central Node Configuration
# Copy this file to .env.central and configure production secrets.
# Never commit .env.central to version control.

CIPHERCHAT_MYSQL_HOST=mysql
CIPHERCHAT_MYSQL_PORT=3306
CIPHERCHAT_MYSQL_DATABASE=cipherchat_central
CIPHERCHAT_MYSQL_USER=cipheruser
CIPHERCHAT_MYSQL_PASSWORD=change-this-mysql-password-min-16-chars

CIPHERCHAT_SESSION_SECRET=change-this-session-secret-min-32-characters-required
CIPHERCHAT_ALICE_PASSWORD=alice-strong-password-or-pbkdf2-hash
CIPHERCHAT_BOB_PASSWORD=bob-strong-password-or-pbkdf2-hash
CIPHERCHAT_MALLORY_PASSWORD=mallory-strong-password-or-pbkdf2-hash

CIPHERCHAT_COOKIE_SECURE=1
CIPHERCHAT_CENTRAL_ONLY=1
CIPHERCHAT_PROXY_SECRET=change-this-proxy-secret-min-32-characters-required

CIPHERCHAT_BIND_HOST=0.0.0.0
CIPHERCHAT_BIND_PORT=8765
CIPHERCHAT_ENABLE_DESTRUCTIVE_DEMO=0
# Set BOTH flags only for a separate disposable database snapshot.
CIPHERCHAT_DISPOSABLE_LAB=0
CIPHERCHAT_TIMESTAMP_WINDOW_SECONDS=300

# Optional: comma-separated allowed CORS origins
# CIPHERCHAT_ALLOWED_ORIGINS=https://cipherchat.example.com

# Optional independent checkpoint file:
# CIPHERCHAT_AUDIT_CHECKPOINT=/path/to/trusted.checkpoint.json

# Optional DDL credentials used only by the migration CLI:
# CIPHERCHAT_MIGRATION_MYSQL_USER=cipherchat_migrator
# CIPHERCHAT_MIGRATION_MYSQL_PASSWORD=replace-with-migration-password
