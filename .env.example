# Copy to .env and replace every secret. Never commit .env.
CIPHERCHAT_MYSQL_HOST=localhost
CIPHERCHAT_MYSQL_PORT=3306
CIPHERCHAT_MYSQL_DATABASE=cipherchat
CIPHERCHAT_MYSQL_USER=cipheruser
CIPHERCHAT_MYSQL_PASSWORD=
CIPHERCHAT_SESSION_SECRET=
CIPHERCHAT_ALICE_PASSWORD=
CIPHERCHAT_BOB_PASSWORD=
CIPHERCHAT_MALLORY_PASSWORD=
CIPHERCHAT_COOKIE_SECURE=0
CIPHERCHAT_ENABLE_DESTRUCTIVE_DEMO=0
CIPHERCHAT_TIMESTAMP_WINDOW_SECONDS=300
# Optional independent checkpoint file, copied from another computer:
# CIPHERCHAT_AUDIT_CHECKPOINT=/path/to/trusted.checkpoint.json
